{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "kosman-daily": {
      "schedule": "0 0 * * *",
      "path": "/api/cron/daily",
      "requestMethod": "GET"
    },
    "kosman-monthly": {
      "schedule": "0 0 1 * *",
      "path": "/api/cron/monthly",
      "requestMethod": "GET"
    }
  }
}
