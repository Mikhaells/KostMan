# --- Lokal (PostgreSQL 18 / postgres:password) ---
APP_ENV=development
APP_PORT=8081                 # diabaikan jika env PORT diset (Render)
APP_URL=http://localhost:8081
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/kosman?sslmode=disable

JWT_SECRET=change-this-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars
ENCRYPTION_KEY=change-this-32-byte-encryption-key

# Email: SMTP lokal (Mailpit) untuk development
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KosMan <noreply@kosman.local>

# Email produksi (disarankan di Render: SMTP diblokir, pakai HTTPS API)
RESEND_API_KEY=

# Upload produksi (Render filesystem ephemeral -> pakai Cloudinary)
# Untuk lokal, kosongkan keduanya agar file disimpan ke STORAGE_DIR
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

STORAGE_DIR=./uploads
MAX_UPLOAD_MB=5
CRON_ENABLED=true
FRONTEND_DIST=../frontend/dist
