# Salin ke .env.local untuk development, atau isi di Vercel → Project Settings → Environment Variables.
# Wajib: gunakan connection string Neon dengan sslmode=require di produksi.
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/kosman?sslmode=disable

# URL aplikasi (dipakai untuk tautan reset password).
APP_URL=http://localhost:3000

# WAJIB diganti di produksi. Buat string acak minimal 32 karakter.
JWT_SECRET=change-this-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars
ENCRYPTION_KEY=change-this-encryption-key-min-32-chars

# Opsional: dikirim oleh Vercel Cron sebagai Authorization: Bearer <secret>.
CRON_SECRET=

# Opsional: email transaksional via Resend HTTPS API. Tanpa ini email tidak dikirim.
RESEND_API_KEY=
SMTP_FROM=KosMan <noreply@kosman.id>

# Opsional: upload gambar ke Cloudinary. Tanpa ini upload menjadi data URL.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Opsional: batas ukuran upload (MB) dan TTL token.
MAX_UPLOAD_MB=5
JWT_ACCESS_TTL_MINUTES=1440
JWT_REFRESH_TTL_DAYS=7
