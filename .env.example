# Copy to .env and adjust before running docker compose
# For local PostgreSQL 18 (postgres / password), use the DATABASE_URL below in backend/.env
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/kosman?sslmode=disable

# Used only by docker-compose.yml
POSTGRES_USER=kosman
POSTGRES_PASSWORD=kosman_secret
POSTGRES_DB=kosman

# Port 8081 dipakai karena 8080 sudah dipakai httpd di mesin lokal
APP_PORT=8081
APP_URL=http://localhost:8081
JWT_SECRET=change-this-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KosMan <noreply@kosman.local>

VITE_API_URL=/api/v1
